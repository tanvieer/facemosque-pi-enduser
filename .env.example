# Copy to .env and fill in. Never commit .env.
#
# EXPO_PUBLIC_API_KEY is the only value with no default -- everything else
# below is already set to something that works, so a fresh clone runs as soon
# as you paste your key in. install.sh handles the system side.

# ---- Facemosque API -------------------------------------------------------
# The one thing you must supply.
EXPO_PUBLIC_API_KEY=

EXPO_PUBLIC_API_BASE_URL=https://facemosque.com

# Your mosque's numeric id -- the API rejects slugs. 4 is Takaful Mosque
# (Reichenhainer Str. 5, 09126 Chemnitz), the mosque this was built for.
# Look yours up with:
#   curl -s -H "X-API-Key: YOUR_KEY" https://facemosque.com/api/v1/mosques
MOSQUE_ID=4

# IANA zone of the mosque: Europe/Berlin, Asia/Dhaka, America/New_York, ...
# The API reports "UTC" for some mosques but serves local wall-clock times,
# so the zone is set here rather than trusted from the payload.
TIMEZONE=Europe/Berlin

# ---- Audio ----------------------------------------------------------------
# Any format ffmpeg can read. Relative paths resolve against the repo root.
AUDIO_PATH=audio/adhan.m4a
# Optional: a different file for Fajr. Falls back to AUDIO_PATH when unset.
AUDIO_PATH_FAJR=

# No volume setting on purpose: the adhan plays at unity gain and the
# speaker's own volume is the only control.

# ---- Bluetooth speaker ----------------------------------------------------
# Run `./adhanctl pair` once to discover and pair; it writes the MAC back here.
BT_SINK_MAC=
BT_SINK_NAME=Echo

# ---- Alexa voice control (experimental, off) ------------------------------
# Emulates a WeMo smart plug on the LAN so "Alexa, turn off <name>" would stop
# playback. Current Echo firmware no longer discovers local WeMo devices -- a
# full app-driven scan produced no M-SEARCH probes at all -- so this is off by
# default. Set to true to try it on another Echo generation; see the README.
ALEXA_ENABLED=false
ALEXA_DEVICE_NAME=Adhan
ALEXA_PORT=52000

# ---- Schedule -------------------------------------------------------------
SCHEDULE_DAYS=30
REFRESH_INTERVAL_DAYS=3
# Which prayers get an adhan, comma separated.
PRAYERS=fajr,dhuhr,asr,maghrib,isha

# On Friday the jummah adhan replaces dhuhr. A mosque can hold several jummah
# prayers -- Takaful holds three, in Arabic and English -- so this picks which
# one plays:
#   blank  every jummah gets an adhan
#   2      only the 2nd
#   9      more than the mosque holds, so the last one -- never silence
# The order is the mosque's own, shown by `./adhanctl show`.
JUMMAH=

# ---- Offline fallback -----------------------------------------------------
# Prayer times committed to the repo, used when the API cannot be reached.
# Defaults to data/mosque-<MOSQUE_ID>.json, so a different mosque never picks
# up Takaful's times by accident. Regenerate with `./adhanctl bundle` and
# commit the result.
#
# The service also keeps its own copy in STATE_DIR/fallback.json, rebuilt on
# the 1st of every month -- or as soon after that as it can reach the API.
# That one needs no configuration.
FALLBACK_PATH=

# ---- Paths ----------------------------------------------------------------
# STATE_DIR=~/.local/state/adhan
