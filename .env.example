# Copy to .env and fill in. Never commit .env.
# Everything the service needs is here; install.sh handles the system side.

# ---- Facemosque API -------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=https://facemosque.com
EXPO_PUBLIC_API_KEY=

# Your mosque's numeric id -- the API rejects slugs. Look yours up with:
#   curl -s -H "X-API-Key: YOUR_KEY" https://facemosque.com/api/v1/mosques
# For example, 4 is Takaful Mosque (Reichenhainer Str. 5, 09126 Chemnitz).
MOSQUE_ID=

# IANA zone of the mosque: Europe/Berlin, Asia/Dhaka, America/New_York, ...
# The API reports "UTC" for some mosques but serves local wall-clock times,
# so the zone is set here rather than trusted from the payload.
TIMEZONE=

# ---- Audio ----------------------------------------------------------------
# Any format ffmpeg can read. Relative paths resolve against the repo root.
AUDIO_PATH=audio/adhan.m4a
# Optional: a different file for Fajr. Falls back to AUDIO_PATH when unset.
AUDIO_PATH_FAJR=

# No volume setting on purpose: the adhan plays at unity gain and the
# speaker's own volume is the only control.

# ---- Bluetooth speaker ----------------------------------------------------
# Run `./adhanctl pair` once to discover and pair; it writes the MAC back here.
BT_SINK_MAC=
BT_SINK_NAME=Echo

# ---- Alexa voice control (experimental, off) ------------------------------
# Emulates a WeMo smart plug on the LAN so "Alexa, turn off <name>" would stop
# playback. Current Echo firmware no longer discovers local WeMo devices -- a
# full app-driven scan produced no M-SEARCH probes at all -- so this is off by
# default. Set to true to try it on another Echo generation; see the README.
ALEXA_ENABLED=false
ALEXA_DEVICE_NAME=Adhan
ALEXA_PORT=52000

# ---- Schedule -------------------------------------------------------------
SCHEDULE_DAYS=30
REFRESH_INTERVAL_DAYS=3
# Which prayers get an adhan, comma separated.
PRAYERS=fajr,dhuhr,asr,maghrib,isha

# ---- Paths ----------------------------------------------------------------
# STATE_DIR=~/.local/state/adhan
